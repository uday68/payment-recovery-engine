# ==============================================================================
# Razorpay Recovery Engine - Environment Configuration Template
# ==============================================================================
# Copy this file to .env and replace placeholder values with your secure secrets.
# NEVER commit your actual .env file or real credentials to version control.
# ==============================================================================

# --- PostgreSQL Database ---
POSTGRES_USER=recovery_user
POSTGRES_PASSWORD=replace_with_a_secure_database_password
POSTGRES_DB=recovery_engine
POSTGRES_PORT=5432
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:${POSTGRES_PORT}/${POSTGRES_DB}

# --- Redis Distributed Cache & Rate Limiting ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# --- Apache Kafka Event Streaming ---
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_EXTERNAL_PORT=9092
KAFKA_RECOVERY_TOPIC=recovery.payment.failed
KAFKA_DLQ_TOPIC=recovery.payment.failed.dlq

# --- Elasticsearch Decision Audit Store (Optional Profile) ---
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_INDEX=recovery-audit-decisions

# --- Go Execution Microservice ---
GO_EXECUTOR_URL=http://localhost:8080

# --- FastAPI Application ---
API_HOST=0.0.0.0
API_PORT=8000
